GITHUB_APP_ID=
# Either paste the PEM content directly (use \n for newlines if your platform
# requires a single-line value), or set GITHUB_APP_PRIVATE_KEY_PATH instead.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
OPENAI_API_KEY=
# Cheapest model with enough quality for README writing. Swap to gpt-5-nano
# for even lower cost (lower quality), or a bigger model for tougher repos.
OPENAI_MODEL=gpt-5-mini
